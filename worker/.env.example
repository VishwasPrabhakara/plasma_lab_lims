# Example environment file for the Cloudflare Worker.
#
# This file documents the secrets the Worker expects. In production these
# live in Cloudflare's secret store, not on disk:
#
#   cd worker
#   npx wrangler secret put JWT_SECRET
#   npx wrangler secret put RESEND_API_KEY       # optional
#   npx wrangler secret put SMTP_FROM            # optional
#   npx wrangler secret put GMAIL_APPS_SCRIPT_URL  # optional (alternative to Resend)
#
# For local development (`wrangler dev`), copy this file to
# `worker/.dev.vars` (NOT committed) and set real values. .gitignore
# already excludes it.

# Required. 32+ character secret used to sign HS256 JWTs. The Worker refuses
# to start if this is missing or too short.
JWT_SECRET=please-replace-me-with-at-least-32-chars-of-random

# Optional: Resend API key + from-address for outbound OTP email.
# Signup / password-reset still work without this — codes are just logged
# in the audit table instead of emailed. First-user signup never needs
# email delivery.
# RESEND_API_KEY=
# SMTP_FROM=noreply@your-domain.example

# Optional: alternative to Resend — a URL to a Gmail Apps Script relay
# that accepts { to, otp, subject } POSTs.
# GMAIL_APPS_SCRIPT_URL=
